  {
    "name": "measured: PascalCase reports apply_patch as Edit with the raw patch string",
    "event": "post-edit",
    "dialect_arg": "auto",
    "env": {
      "COPILOT_CLI": "1"
    },
    "payload": {
      "hook_event_name": "PostToolUse",
      "session_id": "m-cp-1",
      "timestamp": "2026-10-25T21:59:25.699Z",
      "cwd": "<REPO>",
      "tool_name": "Edit",
      "tool_input": "*** Begin Patch\n*** Add File: <REPO>/tests/e.test.js\n+it.skip('e', () => {});\n*** End Patch\n",
      "tool_result": {
        "result_type": "success",
        "text_result_for_llm": "Added 1 file(s): <REPO>/tests/e.test.js"
      }
    },
    "expect": {
      "keys": [
        "additionalContext"
      ],
      "match": {
        "additionalContext": "tests/e\\.test\\.js \\(test file\\): adds a skip/focus marker \\(\\S+\\) at line 1"
      }
    }
  },
