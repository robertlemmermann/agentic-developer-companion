"""Fixtures for live probes: base URL, bearer token, tenant and test-run tag come from the
environment the trusted runner (adc.mjs live run) provides. No credential or budget logic here."""

import json
import os

import httpx
import pytest


def record_result(response):
    """Tell the runner the HTTP status (401/403 become AUTH_REJECTED) and the response headers
    (it reads only the configured cost header) through ADC_PROBE_RESULT. Never request data."""
    path = os.environ.get("ADC_PROBE_RESULT")
    if path:
        with open(path, "w", encoding="utf-8") as fh:
            json.dump({"status": response.status_code, "headers": dict(response.headers)}, fh)


def assert_writes_allowed():
    """Kill switch, checked before every write: LIVE_TESTS_ENABLED set to anything but "true" refuses."""
    flag = os.environ.get("LIVE_TESTS_ENABLED")
    if flag is not None and flag != "true":
        raise RuntimeError(f"writes refused: LIVE_TESTS_ENABLED={flag} (the kill switch is on)")


@pytest.fixture(scope="session")
def client():
    headers = {"accept": "application/json", "x-test-run": os.environ.get("ADC_TEST_RUN_ID", "manual")}
    token = os.environ.get("ADC_LIVE_TOKEN")
    if token:
        headers["authorization"] = f"Bearer {token}"
    tenant = os.environ.get("ADC_LIVE_TENANT")
    if tenant:
        headers["x-tenant"] = tenant
    base_url = (os.environ.get("ADC_LIVE_BASE_URL") or "{{base_url}}").rstrip("/")
    with httpx.Client(base_url=base_url, headers=headers, timeout=30.0, event_hooks={"response": [record_result]}) as c:
        yield c

