// Live probes (Playwright API testing, no browser needed). Run them through the companion's
// trusted runner, which loads ADC_LIVE_TOKEN, enforces the budget and redacts the token:
//   node <skill>/scripts/adc.mjs live run --json
// This project holds no credential or budget logic of its own.
import { defineConfig } from '@playwright/test';

const token = process.env.ADC_LIVE_TOKEN;
const tenant = process.env.ADC_LIVE_TENANT;

export default defineConfig({
  testDir: './probes',
  outputDir: './test-results',
  fullyParallel: false,
  workers: 1,
  retries: 0,
  forbidOnly: true,
  timeout: 60_000,
  reporter: [['list'], ['junit', { outputFile: 'test-results/junit.xml' }]],
  use: {
    baseURL: process.env.ADC_LIVE_BASE_URL || '{{base_url}}',
    // Authenticated probes: traces, HAR files and failure reports record request headers, so
    // nothing that could hold the token is recorded (the choice is in live-checklist.md).
    trace: 'off',
    screenshot: 'off',
    video: 'off',
    extraHTTPHeaders: {
      ...(token ? { Authorization: `Bearer ${token}` } : {}),
      ...(tenant ? { 'X-Tenant': tenant } : {}),
      'X-Test-Run': process.env.ADC_TEST_RUN_ID || 'manual',
    },
  },
});

@@@ file: probes/support/result.ts lang=ts @@@
// Tells the trusted runner the HTTP outcome through ADC_PROBE_RESULT: the status (401/403 become
// AUTH_REJECTED in the ledger) and the response headers (the runner reads only the configured
// cost header). Never write request headers or bodies here.
import fs from 'node:fs';
import type { APIResponse } from '@playwright/test';

export function recordResult(res: APIResponse): void {
  const file = process.env.ADC_PROBE_RESULT;
  if (!file) return;
  fs.writeFileSync(file, JSON.stringify({ status: res.status(), headers: res.headers() }));
}

/** Kill switch, checked before every write: LIVE_TESTS_ENABLED set to anything but "true" refuses. */
export function assertWritesAllowed(): void {
  const flag = process.env.LIVE_TESTS_ENABLED;
  if (flag !== undefined && flag !== 'true') throw new Error(`writes refused: LIVE_TESTS_ENABLED=${flag} (the kill switch is on)`);
}

@@@ file: probes/readonly/health.spec.ts lang=ts @@@
import { test, expect } from '@playwright/test';
import { recordResult } from '../support/result';

// Read-only probe (cost 1): the service answers its health endpoint, {{health_path}}.
test('the health endpoint reports pass or warn', { tag: '@readonly' }, async ({ request }) => {
  const res = await request.get('{{health_path}}');
  recordResult(res);
  expect(res.status(), `GET {{health_path}} answered ${res.status()}`).toBeLessThan(400);
  if (/json/.test(res.headers()['content-type'] || '')) {
    const body = await res.json();
    // application/health+json: status is pass | warn | fail; other formats name it differently.
    if (body && typeof body === 'object' && 'status' in body) {
      expect(['pass', 'warn', 'ok', 'up', 'healthy']).toContain(String(body.status).toLowerCase());
    }
  }
});

@@@ file: probes/synthetic/create-and-cleanup.spec.ts lang=ts when=synthetic @@@
import { test, expect } from '@playwright/test';
import { assertWritesAllowed, recordResult } from '../support/result';

// Synthetic (write) probe, allowed by live-checklist.md. Estimated cost: {{synthetic_cost}} credits.
// - the kill switch is checked before every write
// - every record carries a unique test marker and an idempotency key
// - cleanup always runs (afterEach), also when the probe fails
// ADAPT: RESOURCE and the payload to the dedicated test tenant's API.
const RESOURCE = '/api/test-records';
const marker = `adc-live-${process.env.ADC_TEST_RUN_ID || 'manual'}-${Date.now()}`;
const created: string[] = [];

test.afterEach(async ({ request }) => {
  for (const id of created.splice(0)) {
    const res = await request.delete(`${RESOURCE}/${encodeURIComponent(id)}`);
    expect(res.status(), `cleanup of ${id}`).toBeLessThan(500);
  }
});

test('create, read and delete a marked test record', { tag: '@synthetic' }, async ({ request }) => {
  assertWritesAllowed();
  const res = await request.post(RESOURCE, {
    headers: { 'Idempotency-Key': marker },
    data: { name: marker, test_marker: marker },
  });
  recordResult(res);
  expect(res.status(), `POST ${RESOURCE} answered ${res.status()}`).toBeLessThan(300);
  const body = await res.json();
  created.push(String(body.id));
  const read = await request.get(`${RESOURCE}/${encodeURIComponent(String(body.id))}`);
  expect(read.status()).toBe(200);
});

@@@ file: probes/support/client.mjs lang=js @@@
// HTTP client for live probes: base URL, bearer token, tenant and test-run tag come from the
// environment the trusted runner (adc.mjs live run) provides. No credential or budget logic here.
import fs from 'node:fs';

export const BASE_URL = (process.env.ADC_LIVE_BASE_URL || '{{base_url}}').replace(/\/+$/, '');

/** One request; resolves to { status, headers, text, json } and reports the outcome to the runner. */
export async function request(method, urlPath, options = {}) {
  const headers = { accept: 'application/json', 'x-test-run': process.env.ADC_TEST_RUN_ID || 'manual', ...options.headers };
  if (process.env.ADC_LIVE_TOKEN) headers.authorization = `Bearer ${process.env.ADC_LIVE_TOKEN}`;
  if (process.env.ADC_LIVE_TENANT) headers['x-tenant'] = process.env.ADC_LIVE_TENANT;
  if (options.body !== undefined) headers['content-type'] = 'application/json';
  const res = await fetch(`${BASE_URL}${urlPath}`, {
    method,
    headers,
    body: options.body === undefined ? undefined : JSON.stringify(options.body),
    signal: AbortSignal.timeout(30_000),
  });
  const text = await res.text();
  recordResult(res);
  // JSON when the server says so (a malformed JSON body fails the probe); anything else stays text.
  const json = /\bjson\b/i.test(res.headers.get('content-type') || '') && text ? JSON.parse(text) : null;
  return { status: res.status, headers: res.headers, text, json };
}

/**
 * Tell the runner the HTTP status (401/403 become AUTH_REJECTED) and the response headers (it
 * reads only the configured cost header) through ADC_PROBE_RESULT. Never request data.
 */
export function recordResult(res) {
  const file = process.env.ADC_PROBE_RESULT;
  if (!file) return;
  fs.writeFileSync(file, JSON.stringify({ status: res.status, headers: Object.fromEntries(res.headers) }));
}

/** Kill switch, checked before every write: LIVE_TESTS_ENABLED set to anything but "true" refuses. */
export function assertWritesAllowed() {
  const flag = process.env.LIVE_TESTS_ENABLED;
  if (flag !== undefined && flag !== 'true') throw new Error(`writes refused: LIVE_TESTS_ENABLED=${flag} (the kill switch is on)`);
}

