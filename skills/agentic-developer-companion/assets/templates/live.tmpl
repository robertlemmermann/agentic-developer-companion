import { test } from 'node:test';
import assert from 'node:assert/strict';
import { assertWritesAllowed, request } from '../support/client.mjs';

// Synthetic (write) probe, allowed by live-checklist.md. Estimated cost: {{synthetic_cost}} credits.
// - the kill switch is checked before every write
// - every record carries a unique test marker and an idempotency key
// - cleanup always runs (finally), also when the probe fails
// ADAPT: RESOURCE and the payload to the dedicated test tenant's API.
const RESOURCE = '/api/test-records';

test('create, read and delete a marked test record', async () => {
  const marker = `adc-live-${process.env.ADC_TEST_RUN_ID || 'manual'}-${Date.now()}`;
  assertWritesAllowed();
  const res = await request('POST', RESOURCE, { body: { name: marker, test_marker: marker }, headers: { 'idempotency-key': marker } });
  assert.ok(res.status < 300, `POST ${RESOURCE} answered ${res.status}`);
  const id = String(res.json && res.json.id);
  try {
    const read = await request('GET', `${RESOURCE}/${encodeURIComponent(id)}`);
    assert.equal(read.status, 200);
  } finally {
    const del = await request('DELETE', `${RESOURCE}/${encodeURIComponent(id)}`);
    assert.ok(del.status < 500, `cleanup of ${id} answered ${del.status}`);
  }
});

