@@@ file: .github/workflows/live-probes.yml scope=repo @@@
{{header}}
# Scheduled live probes, executed by the companion's trusted runner (never the test runner
# directly). Kill switch: repository variable LIVE_TESTS_ENABLED must be 'true'. Secrets:
# ADC_LIVE_TOKEN in the protected environment "live"{{synthetic_env_note}}.
name: live-probes

on:
  schedule:
    - cron: '{{cron}}'
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: live-probes
  cancel-in-progress: false

jobs:
  readonly:
    if: ${{ vars.LIVE_TESTS_ENABLED == 'true' }}
    runs-on: ubuntu-latest
    environment: live
    timeout-minutes: 30
    defaults:
      run:
        shell: bash
    steps:
      - uses: actions/checkout@v7
      - uses: actions/setup-node@v7
        with:
          node-version: 24
{{probe_setup}}
{{get_adc}}
      - name: Read-only probes
        env:
          ADC_LIVE_TOKEN: ${{ secrets.ADC_LIVE_TOKEN }}
          ADC_LIVE_BASE_URL: ${{ vars.ADC_LIVE_BASE_URL }}
          ADC_LIVE_TENANT: ${{ vars.ADC_LIVE_TENANT }}
          ADC_LIVE_BUDGET: ${{ vars.ADC_LIVE_BUDGET }}
          LIVE_TESTS_ENABLED: ${{ vars.LIVE_TESTS_ENABLED }}
        run: |
          node "$ADC" live run --probes 'readonly/*' --json > "$RUNNER_TEMP/live-readonly.json"
      - uses: actions/upload-artifact@v7
        if: ${{ !cancelled() }}
        with:
          name: live-readonly
          path: ${{ runner.temp }}/live-readonly.json
          retention-days: 1
{{synthetic_job}}

