@@@ file: test_{{characterize_name}}_characterization.py lang=python when=characterize @@@
"""Characterization (golden master) test: it records what the code does TODAY, before you change
it, so a fix or refactor cannot change other behavior unnoticed. The first local run writes the
golden file; review it (it captures current behavior, bugs included) and commit it. syrupy
(`assert value == snapshot`) is the library alternative when the project already uses it."""

import json
import os
from pathlib import Path

GOLDEN = Path(__file__).parent / "__golden__" / "{{characterize_name}}.json"

# ADAPT: a family of inputs around {{issue_ref}} (edge cases, the bug's input, normal cases).
INPUTS = []


def subject(value):
    # ADAPT: call the code under test and return plain data (no dates, ids or paths that change).
    return value


def test_current_behavior_is_unchanged():
    assert INPUTS, "add the inputs to characterize (INPUTS)"
    actual = json.dumps([{"input": i, "output": subject(i)} for i in INPUTS], indent=2) + "\n"
    if os.environ.get("UPDATE_GOLDEN") == "1" or (not GOLDEN.exists() and not os.environ.get("CI")):
        GOLDEN.parent.mkdir(parents=True, exist_ok=True)
        GOLDEN.write_text(actual, encoding="utf-8", newline="\n")
        return
    assert actual == GOLDEN.read_text(encoding="utf-8").replace("\r\n", "\n"), "behavior changed; review the diff, then UPDATE_GOLDEN=1 accepts it"

