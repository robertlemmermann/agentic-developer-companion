{{test_header}}
import assert from 'node:assert/strict';
import fs from 'node:fs';
import path from 'node:path';

// Characterization (golden master) test: it records what the code does TODAY, before you change
// it, so a fix or refactor cannot change other behavior unnoticed. The first local run writes the
// golden file; review it (it captures current behavior, bugs included) and commit it.
const GOLDEN = path.resolve(process.cwd(), '{{golden_dir}}', '{{characterize_name}}.json');

// ADAPT: a family of inputs around {{issue_ref}} (edge cases, the bug's input, normal cases).
const INPUTS: unknown[] = [];

// ADAPT: call the code under test and return plain data (no dates, ids or paths that change).
function subject(input: unknown): unknown {
  return input;
}

describe('characterization: {{behavior}}', () => {
  it('current behavior is unchanged', () => {
    assert.ok(INPUTS.length > 0, 'add the inputs to characterize (INPUTS)');
    const actual = JSON.stringify(INPUTS.map((input) => ({ input, output: subject(input) })), null, 2) + '\n';
    if (process.env.UPDATE_GOLDEN === '1' || (!fs.existsSync(GOLDEN) && !process.env.CI)) {
      fs.mkdirSync(path.dirname(GOLDEN), { recursive: true });
      fs.writeFileSync(GOLDEN, actual);
      return;
    }
    assert.equal(actual, fs.readFileSync(GOLDEN, 'utf8').replace(/\r\n/g, '\n'), 'behavior changed; review the diff, then UPDATE_GOLDEN=1 accepts it');
  });
});

