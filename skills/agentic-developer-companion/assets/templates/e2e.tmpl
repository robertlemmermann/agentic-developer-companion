import assert from 'node:assert/strict';
import { api, API_BASE_URL } from '{{client_import}}';
import { expectContract } from '{{contract_import}}';

// Black-box API tests against E2E_API_BASE_URL (default {{base_url}}).
const HEALTH = process.env.E2E_API_HEALTH_PATH || '{{health_path}}';
// ADAPT: endpoints that require credentials (or E2E_API_PROTECTED_PATHS=/a,/b); one negative
// auth test is generated per path.
const PROTECTED_PATHS: string[] = (process.env.E2E_API_PROTECTED_PATHS || '').split(',').map((p) => p.trim()).filter(Boolean);

describe(`API ${API_BASE_URL}`, () => {
  it('the health endpoint answers 2xx/3xx', async () => {
    const res = await api('GET', HEALTH);
    assert.ok(res.status >= 200 && res.status < 400, `GET ${HEALTH} -> ${res.status}: ${res.text.slice(0, 200)}`);
  });

  it('the health response keeps its contract', async () => {
    const res = await api('GET', HEALTH);
    expectContract('get-health', res.body);
  });

  it('an unknown route is a client error, not a server error', async () => {
    const res = await api('GET', '/__e2e_unknown_route__');
    assert.ok(res.status >= 400 && res.status < 500, `expected 4xx, got ${res.status}`);
  });

  for (const protectedPath of PROTECTED_PATHS) {
    it(`${protectedPath} rejects requests without credentials`, async () => {
      const res = await api('GET', protectedPath, { token: null });
      assert.ok([401, 403].includes(res.status), `expected 401/403 without credentials, got ${res.status}`);
    });
  }
});

