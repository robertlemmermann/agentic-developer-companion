import type { Locator, Page } from '@playwright/test';

/** Page object for the start page. Prefer role, label and test-id locators over CSS or XPath. */
export class HomePage {
  readonly page: Page;
  readonly main: Locator;

  constructor(page: Page) {
    this.page = page;
    this.main = page.locator('main, [role="main"], body').first();
  }

  async goto(): Promise<void> {
    await this.page.goto('/');
  }
}

