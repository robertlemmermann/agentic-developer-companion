// HTTP client fixture for API end-to-end tests: base URL and credentials come from the
// environment, every request carries a test-run tag. Scaffolded by {{generated_by}}.
export const API_BASE_URL = (process.env.E2E_API_BASE_URL || '{{base_url}}').replace(/\/+$/, '');

export interface ApiResponse {
  status: number;
  headers: Headers;
  body: unknown;
  text: string;
}

export interface ApiOptions {
  body?: unknown;
  /** null sends no credentials (negative tests); undefined uses E2E_API_TOKEN. */
  token?: string | null;
  headers?: Record<string, string>;
}

export async function api(method: string, urlPath: string, options: ApiOptions = {}): Promise<ApiResponse> {
  const token = options.token === undefined ? process.env.E2E_API_TOKEN : options.token;
  const headers: Record<string, string> = {
    accept: 'application/json',
    'x-test-run': process.env.E2E_TEST_RUN_ID || 'local',
    ...options.headers,
  };
  if (token) headers.authorization = `Bearer ${token}`;
  if (options.body !== undefined) headers['content-type'] = 'application/json';
  const res = await fetch(`${API_BASE_URL}${urlPath}`, {
    method,
    headers,
    body: options.body === undefined ? undefined : JSON.stringify(options.body),
    signal: AbortSignal.timeout(15_000),
  });
  const text = await res.text();
  let body: unknown = text;
  try {
    body = text ? JSON.parse(text) : null;
  } catch {
    // Not JSON: keep the text.
  }
  return { status: res.status, headers: res.headers, body, text };
}

@@@ file: contract.ts kind=api lang=ts @@@
// Contract snapshots: the JSON shape of a response (types, not values) is compared with the
// committed file in contracts/. The first local run writes it; CI (CI=true) never does.
import assert from 'node:assert/strict';
import fs from 'node:fs';
import path from 'node:path';

const DIR = path.resolve(process.cwd(), process.env.CONTRACTS_DIR || '{{contracts_dir}}');

/** Types instead of values: contracts ignore data churn but catch renamed or retyped fields. */
export function shapeOf(value: unknown): unknown {
  if (value === null) return 'null';
  if (Array.isArray(value)) return value.length ? [shapeOf(value[0])] : [];
  if (typeof value === 'object') {
    const record = value as Record<string, unknown>;
    const out: Record<string, unknown> = {};
    for (const key of Object.keys(record).sort()) out[key] = shapeOf(record[key]);
    return out;
  }
  return typeof value;
}

export function expectContract(name: string, value: unknown): void {
  const file = path.join(DIR, `${name}.json`);
  const actual = JSON.stringify(shapeOf(value), null, 2) + '\n';
  if (process.env.UPDATE_CONTRACTS === '1' || (!fs.existsSync(file) && !process.env.CI)) {
    fs.mkdirSync(DIR, { recursive: true });
    fs.writeFileSync(file, actual);
    return;
  }
  assert.ok(fs.existsSync(file), `contract ${name}.json is missing: run the tests locally (or with UPDATE_CONTRACTS=1) and commit it`);
  assert.equal(actual, fs.readFileSync(file, 'utf8').replace(/\r\n/g, '\n'), `the response shape changed (${name}.json); review it, then UPDATE_CONTRACTS=1 accepts it`);
}

