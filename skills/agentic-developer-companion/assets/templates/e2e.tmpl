import assert from 'node:assert/strict';
import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import { PROJECT_ROOT, runCli, normalize, expectGolden } from '{{harness_import}}';

// End-to-end tests for the {{cli_name}} CLI: a real process, real exit codes, golden output.
// ADAPT: an invocation the CLI must reject.
const INVALID_ARGS = ['--definitely-not-an-option'];

describe('{{cli_name}} CLI (end-to-end)', () => {
  it('--help exits 0 and prints usage on stdout', () => {
    const r = runCli(['--help']);
    assert.equal(r.code, 0, `exit ${r.code}: ${r.stderr}`);
    assert.match(r.stdout, /\S/, 'usage text expected on stdout');
  });

  it('--help output matches golden/help.golden', () => {
    expectGolden('help', normalize(runCli(['--help']).stdout));
  });

  it('rejects an invalid invocation with a non-zero exit and a message on stderr', () => {
    const r = runCli(INVALID_ARGS);
    assert.notEqual(r.code, 0, 'an invalid invocation must fail');
    assert.match(r.stderr, /\S/, 'the error message belongs on stderr');
  });

  it('runs from any working directory', () => {
    const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'cli-e2e-'));
    try {
      const r = runCli(['--help'], { cwd: dir });
      assert.equal(r.code, 0, `exit ${r.code}: ${r.stderr}`);
    } finally {
      fs.rmSync(dir, { recursive: true, force: true });
    }
  });

  it('normalize() masks roots, line endings, timestamps and durations', () => {
    const sample = `wrote ${path.join(PROJECT_ROOT, 'out', 'a.txt')}\r\nat 2026-01-02T03:04:05.678Z in 12ms\r\n`;
    assert.equal(normalize(sample), 'wrote <ROOT>/out/a.txt\nat <TIMESTAMP> in <DURATION>\n');
  });
});

