import { test, expect } from '../fixtures';

// A fixed clock makes date-dependent rendering deterministic.
const FIXED_NOW = new Date('2026-01-15T10:00:00Z');

test.describe('smoke', { tag: '@smoke' }, () => {
  test('the start page renders without uncaught errors', async ({ page, homePage }) => {
    const errors: string[] = [];
    page.on('pageerror', (err) => errors.push(err.message));
    await page.clock.setFixedTime(FIXED_NOW);
    await homePage.goto();
    await expect(page).toHaveTitle(/\S/);
    await expect(homePage.main).toBeVisible();
    expect(errors, 'uncaught errors on the page').toEqual([]);
  });
});

