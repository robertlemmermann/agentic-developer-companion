// Shared fixtures. Specs import { test, expect } from '../fixtures' instead of '@playwright/test'.
// - homePage: page object for the start page
// - one login per parallel worker (storageState per worker) when E2E_USERNAME is set; "{worker}"
//   in E2E_USERNAME gives every worker its own account, so tests that change data never collide
// - third-party calls (analytics, chat widgets) are stubbed at the network boundary
import fs from 'node:fs';
import path from 'node:path';
import { test as base, expect } from '@playwright/test';
import { HomePage } from './pages/home.page';

type Fixtures = { homePage: HomePage; stubThirdParty: void };
type WorkerFixtures = { workerStorageState: string | undefined };

const THIRD_PARTY = /(google-analytics|googletagmanager|doubleclick|segment\.io|hotjar|intercom)\./;

export const test = base.extend<Fixtures, WorkerFixtures>({
  homePage: async ({ page }, use) => {
    await use(new HomePage(page));
  },

  stubThirdParty: [async ({ page }, use) => {
    await page.route(THIRD_PARTY, (route) => route.fulfill({ status: 204, body: '' }));
    await use();
  }, { auto: true }],

  storageState: async ({ workerStorageState }, use) => {
    await use(workerStorageState);
  },

  workerStorageState: [async ({ browser }, use, workerInfo) => {
    const username = process.env.E2E_USERNAME;
    if (!username) {
      await use(undefined);
      return;
    }
    const id = workerInfo.parallelIndex;
    const file = path.join(workerInfo.project.outputDir, '.auth', `${id}.json`);
    if (!fs.existsSync(file)) {
      const page = await browser.newPage({ storageState: undefined, baseURL: workerInfo.project.use.baseURL });
      // ADAPT: the login form of this application.
      await page.goto('/login');
      await page.getByLabel(/user|e-?mail/i).fill(username.replace('{worker}', String(id)));
      await page.getByLabel(/password/i).fill(process.env.E2E_PASSWORD ?? '');
      await page.getByRole('button', { name: /sign in|log in/i }).click();
      // ADAPT: wait for something only signed-in users see.
      await page.waitForURL((url) => !url.pathname.startsWith('/login'));
      fs.mkdirSync(path.dirname(file), { recursive: true });
      await page.context().storageState({ path: file });
      await page.close();
    }
    await use(file);
  }, { scope: 'worker' }],
});

export { expect };

