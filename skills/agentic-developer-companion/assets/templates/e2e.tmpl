"""Contract snapshots: the JSON shape of a response (types, not values) is compared with the
committed file in contracts/. The first local run writes it; CI (CI=true) never does."""

import json
import os
from pathlib import Path

CONTRACTS = Path(os.environ.get("CONTRACTS_DIR") or Path(__file__).parent / "contracts")


def shape_of(value):
    if value is None:
        return "null"
    if isinstance(value, bool):
        return "boolean"
    if isinstance(value, (int, float)):
        return "number"
    if isinstance(value, str):
        return "string"
    if isinstance(value, list):
        return [shape_of(value[0])] if value else []
    if isinstance(value, dict):
        return {key: shape_of(value[key]) for key in sorted(value)}
    return type(value).__name__


def expect_contract(name, value):
    path = CONTRACTS / f"{name}.json"
    actual = json.dumps(shape_of(value), indent=2) + "\n"
    if os.environ.get("UPDATE_CONTRACTS") == "1" or (not path.exists() and not os.environ.get("CI")):
        CONTRACTS.mkdir(parents=True, exist_ok=True)
        path.write_text(actual, encoding="utf-8", newline="\n")
        return
    assert path.exists(), f"contract {name}.json is missing: run the tests locally (or with UPDATE_CONTRACTS=1) and commit it"
    expected = path.read_text(encoding="utf-8").replace("\r\n", "\n")
    assert actual == expected, f"the response shape changed ({name}.json); review it, then UPDATE_CONTRACTS=1 accepts it"

