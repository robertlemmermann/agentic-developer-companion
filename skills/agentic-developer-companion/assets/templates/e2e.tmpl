# Property-based API fuzzing with Schemathesis against {{openapi}}. It sends real requests that
# create, change and delete data: dev/staging only, never production, started by hand.
name: api-fuzz

on:
  workflow_dispatch:
    inputs:
      base_url:
        description: Base URL of a dev or staging deployment
        required: true

permissions:
  contents: read

jobs:
  schemathesis:
    runs-on: ubuntu-latest
    environment: staging
    timeout-minutes: 30
    defaults:
      run:
        shell: bash
    steps:
      - uses: actions/checkout@v7
      - uses: astral-sh/setup-uv@v7
      - name: Schemathesis (examples and coverage phases; add fuzzing once these pass)
        env:
          API_BASE_URL: ${{ inputs.base_url }}
          API_TOKEN: ${{ secrets.E2E_API_TOKEN }}
        run: |
          auth=()
          if [ -n "$API_TOKEN" ]; then auth=(-H "Authorization: Bearer $API_TOKEN"); fi
          uvx schemathesis run {{openapi}} --url "$API_BASE_URL" "${auth[@]}" --checks all --phases examples,coverage --rate-limit 100/m --report junit --report-dir schemathesis-report
      - uses: actions/upload-artifact@v7
        if: ${{ !cancelled() }}
        with:
          name: schemathesis-report
          path: schemathesis-report/
          retention-days: 7

