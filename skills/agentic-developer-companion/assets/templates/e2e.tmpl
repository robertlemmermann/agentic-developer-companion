//! End-to-end tests for the {{cli_name}} CLI: a real process, real exit codes, golden output.
//! Std only; Cargo builds the binary and exposes it as CARGO_BIN_EXE_{{bin_name}}.
//! Scaffolded by {{generated_by}}.

use std::env;
use std::fs;
use std::path::{Path, PathBuf};
use std::process::{Command, Output};

/// An invocation the CLI must reject. ADAPT it.
const INVALID_ARGS: &[&str] = &["--definitely-not-an-option"];

fn run(args: &[&str], dir: Option<&Path>) -> Output {
    let mut cmd = Command::new(env!("CARGO_BIN_EXE_{{bin_name}}"));
    cmd.args(args).env("NO_COLOR", "1");
    cmd.current_dir(dir.map(Path::to_path_buf).unwrap_or_else(manifest_dir));
    cmd.output().expect("failed to start the CLI")
}

fn manifest_dir() -> PathBuf {
    PathBuf::from(env!("CARGO_MANIFEST_DIR"))
}

fn text(bytes: &[u8]) -> String {
    String::from_utf8_lossy(bytes).into_owned()
}

/// True when `s` starts with an ISO-8601 timestamp (YYYY-MM-DDTHH:MM:SS); returns its length.
fn timestamp_len(s: &[u8]) -> Option<usize> {
    let pattern = b"dddd-dd-ddTdd:dd:dd";
    if s.len() < pattern.len() {
        return None;
    }
    for (i, p) in pattern.iter().enumerate() {
        let c = s[i];
        let ok = match *p {
            b'd' => c.is_ascii_digit(),
            b'T' => c == b'T' || c == b' ',
            other => c == other,
        };
        if !ok {
            return None;
        }
    }
    let mut n = pattern.len();
    if n < s.len() && s[n] == b'.' {
        n += 1;
        while n < s.len() && s[n].is_ascii_digit() {
            n += 1;
        }
    }
    if n < s.len() && s[n] == b'Z' {
        n += 1;
    }
    Some(n)
}

/// LF line ends, the crate and temp directories masked with POSIX separators, timestamps masked.
fn normalize(input: &str) -> String {
    let mut out = input.replace("\r\n", "\n").replace('\r', "\n");
    let mut roots: Vec<(&str, String)> = Vec::new();
    for (label, dir) in [("<ROOT>", manifest_dir()), ("<TMP>", env::temp_dir())] {
        let s = dir.to_string_lossy().trim_end_matches(['/', '\\']).to_string();
        if s.len() > 1 {
            roots.push((label, s.replace('\\', "/")));
            roots.push((label, s));
        }
    }
    roots.sort_by(|a, b| b.1.len().cmp(&a.1.len()));
    for (label, dir) in &roots {
        out = out.replace(dir.as_str(), label);
    }
    let bytes = out.as_bytes();
    let mut result = String::with_capacity(out.len());
    let mut i = 0;
    let mut after_label = false;
    while i < bytes.len() {
        if let Some(n) = timestamp_len(&bytes[i..]) {
            result.push_str("<TIMESTAMP>");
            i += n;
            continue;
        }
        let c = out[i..].chars().next().unwrap();
        if c == '>' {
            after_label = result.ends_with("<ROOT") || result.ends_with("<TMP");
            result.push(c);
        } else if after_label && c == '\\' {
            result.push('/');
        } else {
            if c.is_whitespace() {
                after_label = false;
            }
            result.push(c);
        }
        i += c.len_utf8();
    }
    result.lines().map(str::trim_end).collect::<Vec<_>>().join("\n") + if result.ends_with('\n') { "\n" } else { "" }
}

/// Compare with tests/golden/<name>.golden; the first local run (or UPDATE_GOLDEN=1) writes it,
/// CI (CI=true) never does.
fn expect_golden(name: &str, actual: &str) {
    let dir = manifest_dir().join("tests").join("golden");
    let file = dir.join(format!("{name}.golden"));
    if env::var("UPDATE_GOLDEN").as_deref() == Ok("1") || (!file.exists() && env::var_os("CI").is_none()) {
        fs::create_dir_all(&dir).expect("create tests/golden");
        fs::write(&file, actual).expect("write the golden file");
        return;
    }
    let want = fs::read_to_string(&file)
        .unwrap_or_else(|_| panic!("golden file {name}.golden is missing: run the tests locally (or with UPDATE_GOLDEN=1) and commit it"))
        .replace("\r\n", "\n");
    assert_eq!(want, actual, "the output differs from {name}.golden; review it, then UPDATE_GOLDEN=1 accepts it");
}

#[test]
fn help_exits_zero_and_prints_usage() {
    let out = run(&["--help"], None);
    assert!(out.status.success(), "exit {:?}: {}", out.status.code(), text(&out.stderr));
    assert!(!text(&out.stdout).trim().is_empty(), "usage text expected on stdout");
}

#[test]
fn help_matches_golden() {
    let out = run(&["--help"], None);
    expect_golden("help", &normalize(&text(&out.stdout)));
}

#[test]
fn rejects_invalid_invocation() {
    let out = run(INVALID_ARGS, None);
    assert!(!out.status.success(), "an invalid invocation must fail");
    assert!(!text(&out.stderr).trim().is_empty(), "the error message belongs on stderr");
}

#[test]
fn runs_from_any_working_directory() {
    let dir = env::temp_dir();
    let out = run(&["--help"], Some(&dir));
    assert!(out.status.success(), "exit {:?}: {}", out.status.code(), text(&out.stderr));
}

#[test]
fn normalize_masks_roots_line_endings_and_timestamps() {
    let path = manifest_dir().join("out").join("a.txt");
    let sample = format!("wrote {}\r\nat 2026-01-02T03:04:05.678Z\r\n", path.display());
    assert_eq!(normalize(&sample), "wrote <ROOT>/out/a.txt\nat <TIMESTAMP>\n");
}
