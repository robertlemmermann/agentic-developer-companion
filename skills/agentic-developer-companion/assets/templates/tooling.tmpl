// {{name}}: a hook handler for GitHub Copilot, Claude Code and OpenAI Codex.
// Generated by {{generated_by}} (tooling scaffold hooks). Zero dependencies.
//
// Contract on every host: read one JSON payload on stdin, print exactly one JSON object on
// stdout, exit 0. Any error, bad input or a slow run prints {} (no decision): it fails open.
//   node {{script_path}} --dialect copilot|claude|codex --event <event name>
// Test it with: node --test {{test_path}}

import { readFileSync } from 'node:fs';
import { pathToFileURL } from 'node:url';

// Stay well under the host timeout (the generated configs allow 10 seconds).
const TIME_LIMIT_MS = 5000;
const TEST_FILE = /(^|[/\\])(tests?|__tests__|spec)[/\\]|[._-](test|spec)\.[^/\\]+$|(^|[/\\])test_[^/\\]+\.py$/i;

/** Tool name, arguments and touched paths from a Copilot, Claude Code or Codex payload. */
export function normalize(payload, dialect) {
  const p = payload && typeof payload === 'object' ? payload : {};
  let args = p.toolArgs ?? p.tool_input ?? {};
  // Copilot camelCase payloads carry toolArgs as a JSON string.
  if (typeof args === 'string') {
    try { args = JSON.parse(args); } catch { args = { raw: args }; }
  }
  const paths = [];
  for (const key of ['path', 'file_path', 'filePath', 'notebook_path']) {
    if (args && typeof args[key] === 'string') paths.push(args[key]);
  }
  // Codex apply_patch sends the patch text; collect the files it names.
  const patch = [args?.command, args?.input, args?.patch].find((v) => typeof v === 'string') || '';
  for (const m of patch.matchAll(/^\*\*\* (?:Add|Update|Delete) File: (.+)$/gm)) paths.push(m[1].trim());
  return {
    dialect,
    toolName: String(p.toolName ?? p.tool_name ?? ''),
    args,
    paths,
    event: p.hook_event_name ?? p.hookEventName ?? null,
    stopHookActive: p.stop_hook_active === true,
  };
}

/** The check itself. Return null (no decision) or { context } / { deny } / { block }. */
export function decide(norm, event) {
  if (String(event).toLowerCase() === 'posttooluse') {
    const tests = norm.paths.filter((f) => TEST_FILE.test(f));
    if (tests.length) {
      return { context: `Test file edited: ${tests.join(', ')}. Keep its assertions at least as strong as before and run the full suite before reporting success.` };
    }
  }
  return null;
}

const PASCAL = { pretooluse: 'PreToolUse', posttooluse: 'PostToolUse', sessionstart: 'SessionStart', stop: 'Stop', agentstop: 'Stop', userpromptsubmit: 'UserPromptSubmit' };

/** Shape a decision in the host's output dialect. Codex rejects unknown fields. */
export function format(dialect, event, decision) {
  if (!decision) return {};
  const lower = String(event).toLowerCase();
  if (dialect === 'copilot') {
    if (decision.deny && lower === 'pretooluse') return { permissionDecision: 'deny', permissionDecisionReason: decision.deny };
    if (decision.block && (lower === 'agentstop' || lower === 'subagentstop')) return { decision: 'block', reason: decision.block };
    if (decision.context && ['posttooluse', 'sessionstart', 'subagentstart'].includes(lower)) return { additionalContext: decision.context };
    return {};
  }
  const name = PASCAL[lower] || String(event);
  if (decision.deny && name === 'PreToolUse') {
    return { hookSpecificOutput: { hookEventName: 'PreToolUse', permissionDecision: 'deny', permissionDecisionReason: decision.deny } };
  }
  if (decision.block && name === 'Stop') return { decision: 'block', reason: decision.block };
  if (decision.context && ['PostToolUse', 'SessionStart', 'UserPromptSubmit'].includes(name)) {
    return { hookSpecificOutput: { hookEventName: name, additionalContext: decision.context } };
  }
  return {};
}

function emit(obj) {
  // ASCII-only JSON: Windows PowerShell re-encodes stdout with the console code page.
  const text = JSON.stringify(obj).replace(/[\u007f-￿]/g, (c) => '\\u' + c.charCodeAt(0).toString(16).padStart(4, '0'));
  process.stdout.write(text + '\n');
  process.exit(0);
}

function arg(name, fallback) {
  const i = process.argv.indexOf(`--${name}`);
  return i > 0 && process.argv[i + 1] ? process.argv[i + 1] : fallback;
}

export function main() {
  setTimeout(() => emit({}), TIME_LIMIT_MS).unref();
  try {
    const dialect = arg('dialect', 'claude');
    let raw = '';
    try { raw = readFileSync(0, 'utf8'); } catch { raw = ''; }
    const payload = raw.trim() ? JSON.parse(raw) : {};
    const norm = normalize(payload, dialect);
    const event = arg('event', norm.event || '');
    // Never block a stop the host already continued once (loop protection).
    if (norm.stopHookActive) emit({});
    emit(format(dialect, event, decide(norm, event)));
  } catch {
    emit({});
  }
}

if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) main();
@@@ file: {{hooks_dir}}/{{name}}.test.mjs kind=hooks @@@
// Tests for {{name}}: every fixture case runs through the handler as a subprocess, the way
// the hosts run it. Run with: node --test {{test_path}}
import { test } from 'node:test';
import assert from 'node:assert/strict';
import { spawnSync } from 'node:child_process';
import { readFileSync } from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const here = path.dirname(fileURLToPath(import.meta.url));
const handler = path.join(here, '{{name}}.mjs');
const cases = JSON.parse(readFileSync(path.join(here, 'fixtures', '{{name}}.json'), 'utf8'));

for (const c of cases) {
  test(c.name, () => {
    const input = typeof c.payload === 'string' ? c.payload : JSON.stringify(c.payload);
    const res = spawnSync(process.execPath, [handler, '--dialect', c.dialect, '--event', c.event], { input, encoding: 'utf8', timeout: 10000 });
    assert.equal(res.status, 0, res.stderr);
    const lines = res.stdout.trim().split(/\r?\n/);
    assert.equal(lines.length, 1, 'exactly one line of output');
    assert.match(lines[0], /^[\x20-\x7e]*$/, 'ASCII-only output');
    const out = JSON.parse(lines[0]);
    if (c.expect === null) assert.deepEqual(out, {});
    else for (const key of c.expect) assert.notEqual(key.split('.').reduce((o, k) => (o == null ? o : o[k]), out), undefined, `missing ${key}`);
  });
}
