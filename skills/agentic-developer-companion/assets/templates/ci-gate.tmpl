@@@ file: .github/adc/gate.mjs @@@
// {{header_js}}
// CI helper for the generated workflows: test counts, the diff-scope ratchet verdict, coverage
// summaries and the quarantine registry check. Node 24+, no dependencies; report parsing comes
// from the companion skill (ADC=<skill>/scripts/adc.mjs, fetched or vendored by the workflow).
//
//   node .github/adc/gate.mjs counts --format <junit|jest-json|go-test-json|cargo-text|trx|rspec-json|summary>
//        --report <file or glob> [--project <dir>] [--out <counts.json>] [--max-flaky <n>]
//   node .github/adc/gate.mjs ratchet --report <diff-scope.json> --exit <code>
//   node .github/adc/gate.mjs coverage --report <coverage-delta.json>
//   node .github/adc/gate.mjs quarantine --registry <tests/quarantine.json> [--today YYYY-MM-DD]
// Exit codes: 0 pass, 1 the gate fails, 2 usage. Writes the step summary and step outputs.

import fs from 'node:fs';
import path from 'node:path';
import { pathToFileURL } from 'node:url';
import { parseArgs } from 'node:util';

const KEYS = ['executed', 'passed', 'failed', 'errors', 'skipped', 'flaky'];

function summary(markdown) {
  const file = process.env.GITHUB_STEP_SUMMARY;
  if (file) fs.appendFileSync(file, markdown + '\n');
  else process.stdout.write(markdown + '\n');
}

function setOutputs(pairs) {
  const file = process.env.GITHUB_OUTPUT;
  const text = Object.entries(pairs).map(([k, v]) => `${k}=${v}`).join('\n') + '\n';
  if (file) fs.appendFileSync(file, text);
}

function escapeData(value, property = false) {
  let s = String(value ?? '').replace(/%/g, '%25').replace(/\r/g, '%0D').replace(/\n/g, '%0A');
  if (property) s = s.replace(/:/g, '%3A').replace(/,/g, '%2C');
  return s;
}

function annotate(level, message, where = {}) {
  const props = [
    where.file ? `file=${escapeData(where.file, true)}` : null,
    where.line ? `line=${Number(where.line)}` : null,
    where.title ? `title=${escapeData(where.title, true)}` : null,
  ].filter(Boolean).join(',');
  process.stdout.write(`::${level}${props ? ` ${props}` : ''}::${escapeData(message)}\n`);
}

function fail(message, where) {
  annotate('error', message, where);
  process.exitCode = 1;
}

const cell = (s) => String(s ?? '').replace(/\|/g, '\\|').replace(/\r?\n/g, ' ').slice(0, 200);

function globRegExp(glob) {
  let re = '';
  for (let i = 0; i < glob.length; i++) {
    const c = glob[i];
    if (c === '*' && glob[i + 1] === '*') {
      const slash = glob[i + 2] === '/';
      re += slash ? '(?:.*/)?' : '.*';
      i += slash ? 2 : 1;
    } else if (c === '*') re += '[^/]*';
    else if (c === '?') re += '[^/]';
    else re += c.replace(/[.+^$()|[\]\\]/g, '\\$&');
  }
  return new RegExp(`^${re}$`);
}

/** Files matching a path that may contain * and ** (either separator). */
export function expand(pattern) {
  const norm = String(pattern).replace(/\\/g, '/');
  if (!/[*?]/.test(norm)) return fs.existsSync(norm) && fs.statSync(norm).isFile() ? [norm] : [];
  const parts = norm.split('/');
  const fixed = [];
  while (parts.length && !/[*?]/.test(parts[0])) fixed.push(parts.shift());
  const base = fixed.join('/') || '.';
  const re = globRegExp(parts.join('/'));
  const out = [];
  const walk = (dir, rel) => {
    let entries = [];
    try {
      entries = fs.readdirSync(dir, { withFileTypes: true });
    } catch {
      return;
    }
    for (const e of entries) {
      const r = rel ? `${rel}/${e.name}` : e.name;
      if (e.isDirectory()) walk(path.join(dir, e.name), r);
      else if (e.isFile() && re.test(r)) out.push(base === '.' ? r : `${base}/${r}`);
    }
  };
  walk(base, '');
  return out.sort();
}

async function loadReports() {
  const adc = process.env.ADC;
  if (!adc) throw new Error('ADC is not set: the workflow step that provides the companion skill must run first');
  return import(pathToFileURL(path.join(path.dirname(adc), 'lib', 'reports.mjs')).href);
}

async function counts(o) {
  const maxFlaky = o['max-flaky'] == null ? 0 : Number(o['max-flaky']);
  if (!o.format || !o.report || !Number.isInteger(maxFlaky) || maxFlaky < 0) return usage('counts needs --format, --report and a non-negative integer --max-flaky');
  const files = expand(o.report);
  if (!files.length) return fail(`no test report matches ${o.report}: the suite produced none (did it run?)`);
  const reports = await loadReports();
  const total = Object.fromEntries(KEYS.map((k) => [k, 0]));
  for (const file of files) {
    const text = fs.readFileSync(file, 'utf8');
    let r = null;
    try {
      if (o.format === 'summary') {
        const s = reports.parseSummaryText(text);
        if (s) r = { executed: (s.passed || 0) + (s.failed || 0), passed: s.passed || 0, failed: s.failed || 0, errors: 0, skipped: s.skipped || 0, flaky: 0 };
      } else r = reports.parseReport(o.format, text);
    } catch (err) {
      fail(`${file}: ${err.message}`);
      continue;
    }
    if (!r || !Number.isFinite(Number(r.executed))) {
      fail(`${file}: no ${o.format} results could be read`);
      continue;
    }
    for (const k of KEYS) total[k] += Number(r[k]) || 0;
  }
  const project = o.project || '.';
  if (o.out) {
    const doc = { schema: 'adc-counts/1', source: 'ci-gate', format: o.format, commit: process.env.GITHUB_SHA || null, project, ...total, projects: { [project]: total } };
    fs.writeFileSync(o.out, JSON.stringify(doc, null, 2) + '\n');
  }
  setOutputs(total);
  summary(`### Tests: ${cell(project)}\n\n| executed | passed | failed | errors | skipped | flaky |\n|---:|---:|---:|---:|---:|---:|\n| ${KEYS.map((k) => total[k]).join(' | ')} |\n\n${files.length} report file(s), format ${o.format}.`);
  if (total.executed === 0) fail('no test was executed: an empty run is not a pass');
  if (total.failed + total.errors > 0) fail(`${total.failed} failed and ${total.errors} errored test(s)`);
  if (total.flaky > maxFlaky) fail(`${total.flaky} flaky test(s), ${maxFlaky} allowed: a test that passes only on a retry is a flake (see the flake policy)`);
}

function ratchet(o) {
  const code = Number(o.exit);
  if (!o.report || !Number.isInteger(code)) return usage('ratchet needs --report and --exit');
  let doc;
  try {
    doc = JSON.parse(fs.readFileSync(o.report, 'utf8'));
  } catch (err) {
    return fail(`diff-scope produced no readable JSON (exit ${code}): ${err.message}`);
  }
  if (doc && doc.error) return fail(`diff-scope could not run: ${doc.error.code}: ${doc.error.message}`);
  const findings = Array.isArray(doc.findings) ? doc.findings : [];
  const hard = findings.filter((f) => f.severity === 'fail');
  const soft = findings.filter((f) => f.severity === 'finding');
  for (const f of hard) annotate('error', `${f.id}: ${f.message}`, { file: f.file, line: f.line, title: f.id });
  for (const f of soft) annotate('warning', `${f.id}: ${f.message}`, { file: f.file, line: f.line, title: f.id });
  const rows = [...hard, ...soft].slice(0, 60).map((f) => `| ${f.severity} | ${f.id} | ${cell(f.file)}${f.line ? `:${f.line}` : ''} | ${cell(f.message)} |`);
  summary(`### diff-scope ratchet\n\n${hard.length} fail, ${soft.length} finding(s) against ${cell(doc.base && doc.base.ref)}.\n${rows.length ? `\n| severity | check | where | finding |\n|---|---|---|---|\n${rows.join('\n')}\n` : ''}`);
  if (![0, 1].includes(code)) fail(`diff-scope exited ${code}: the change could not be verified`);
  if (hard.length) fail(`${hard.length} fail-severity finding(s): tests, skips, suppressions or CI were weakened`);
}

function coverage(o) {
  if (!o.report) return usage('coverage needs --report');
  let doc;
  try {
    doc = JSON.parse(fs.readFileSync(o.report, 'utf8'));
  } catch (err) {
    return annotate('warning', `no coverage-delta result: ${err.message}`);
  }
  const pct = doc.pct == null ? 'n/a' : `${Number(doc.pct).toFixed(1)}%`;
  const rows = (doc.uncovered || []).slice(0, 40).map((u) => `| ${cell(u.file)} | ${cell((u.lines || []).slice(0, 30).join(', '))} |`);
  summary(`### Changed-line coverage\n\n${pct} of ${doc.changed_lines ?? 0} changed line(s) covered (${cell(doc.tool)}, precision ${cell(doc.precision)}).\n${rows.length ? `\n| file | uncovered lines |\n|---|---|\n${rows.join('\n')}\n` : ''}`);
}

function quarantine(o) {
  if (!o.registry) return usage('quarantine needs --registry');
  let doc;
  try {
    doc = JSON.parse(fs.readFileSync(o.registry, 'utf8'));
  } catch (err) {
    return fail(`${o.registry} is missing or not JSON: ${err.message}`);
  }
  const today = o.today || new Date().toISOString().slice(0, 10);
  const maxDays = Number.isInteger(doc.max_days) ? doc.max_days : 30;
  const tests = Array.isArray(doc.tests) ? doc.tests : null;
  if (!tests) return fail(`${o.registry}: "tests" must be an array`);
  const problems = [];
  const day = (s) => Date.parse(`${s}T00:00:00Z`);
  tests.forEach((t, i) => {
    const where = `tests[${i}]${t && t.id ? ` (${t.id})` : ''}`;
    for (const k of ['id', 'owner', 'issue', 'expires']) {
      if (!t || typeof t[k] !== 'string' || !t[k].trim()) problems.push(`${where}: "${k}" is required`);
    }
    if (!t || typeof t.expires !== 'string') return;
    if (!/^\d{4}-\d{2}-\d{2}$/.test(t.expires) || Number.isNaN(day(t.expires))) problems.push(`${where}: "expires" must be YYYY-MM-DD`);
    else if (t.expires < today) problems.push(`${where}: the quarantine expired on ${t.expires}; fix the test or delete it`);
    else if (typeof t.added === 'string' && !Number.isNaN(day(t.added)) && (day(t.expires) - day(t.added)) / 86_400_000 > maxDays) problems.push(`${where}: quarantined for more than ${maxDays} days`);
  });
  setOutputs({ count: tests.length });
  const rows = tests.slice(0, 100).map((t) => `| ${cell(t && t.id)} | ${cell(t && t.owner)} | ${cell(t && t.issue)} | ${cell(t && t.expires)} |`);
  summary(`### Quarantine\n\n${tests.length} quarantined test(s), ${problems.length} problem(s).\n${rows.length ? `\n| test | owner | issue | expires |\n|---|---|---|---|\n${rows.join('\n')}\n` : ''}`);
  for (const p of problems) fail(p, { file: o.registry });
}

function usage(message) {
  process.stderr.write(`gate.mjs: ${message}\n`);
  process.exitCode = 2;
}

const COMMANDS = {
  counts: [counts, { format: { type: 'string' }, report: { type: 'string' }, project: { type: 'string' }, out: { type: 'string' }, 'max-flaky': { type: 'string' } }],
  ratchet: [ratchet, { report: { type: 'string' }, exit: { type: 'string' } }],
  coverage: [coverage, { report: { type: 'string' } }],
  quarantine: [quarantine, { registry: { type: 'string' }, today: { type: 'string' } }],
};

async function main(argv) {
  const [name, ...rest] = argv;
  const entry = COMMANDS[name];
  if (!entry) return usage(`unknown command "${name ?? ''}" (expected ${Object.keys(COMMANDS).join(', ')})`);
  let values;
  try {
    ({ values } = parseArgs({ args: rest, options: entry[1], strict: true, allowPositionals: false }));
  } catch (err) {
    return usage(err.message);
  }
  return entry[0](values);
}

if (process.argv[1] && pathToFileURL(path.resolve(process.argv[1])).href === import.meta.url) {
  main(process.argv.slice(2)).catch((err) => {
    fail(`gate.mjs: ${err && err.message ? err.message : err}`);
  });
}
