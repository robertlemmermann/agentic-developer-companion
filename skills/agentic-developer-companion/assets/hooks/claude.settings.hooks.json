{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "<SKILL>/scripts/adc.mjs",
              "hook-run",
              "session-start",
              "--dialect",
              "claude"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "<SKILL>/scripts/adc.mjs",
              "hook-run",
              "post-edit",
              "--dialect",
              "claude"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "<SKILL>/scripts/adc.mjs",
              "hook-run",
              "post-shell",
              "--dialect",
              "claude"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "<SKILL>/scripts/adc.mjs",
              "hook-run",
              "pre-guard",
              "--dialect",
              "claude",
              "--level",
              "guard"
            ],
            "timeout": 10,
            "if": "Bash(git *)"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "<SKILL>/scripts/adc.mjs",
              "hook-run",
              "pre-guard",
              "--dialect",
              "claude",
              "--level",
              "guard"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "<SKILL>/scripts/adc.mjs",
              "hook-run",
              "stop",
              "--dialect",
              "claude",
              "--level",
              "advise"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "<SKILL>/scripts/adc.mjs",
              "hook-run",
              "session-end",
              "--dialect",
              "claude"
            ],
            "timeout": 1
          }
        ]
      }
    ]
  }
}
