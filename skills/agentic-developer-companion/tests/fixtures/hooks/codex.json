  {
    "name": "PostToolUse apply_patch (command key): focus marker with patch line numbers",
    "event": "post-edit",
    "dialect_arg": "codex",
    "payload": {
      "session_id": "cx-1",
      "turn_id": "t-1",
      "transcript_path": null,
      "cwd": "<REPO>",
      "hook_event_name": "PostToolUse",
      "model": "gpt-5-codex",
      "permission_mode": "default",
      "tool_name": "apply_patch",
      "tool_input": {
        "command": "*** Begin Patch\n*** Add File: tests/a.test.js\n+import { add } from '../src/add.js';\n+it.only('adds', () => {})\n*** End Patch\n"
      },
      "tool_use_id": "c1",
      "tool_response": "Success. Updated the following files:\nA tests/a.test.js"
    },
    "expect": {
      "keys": [
        "hookSpecificOutput"
      ],
      "values": {
        "hookSpecificOutput.hookEventName": "PostToolUse"
      },
      "match": {
        "hookSpecificOutput.additionalContext": "skip/focus marker \\(\\S+\\) at line 2"
      },
      "session": {
        "edits.count": 1
      }
    }
  },
  {
    "name": "PostToolUse apply_patch (patch key): update + delete of a test",
    "event": "post-edit",
    "dialect_arg": "codex",
    "payload": {
      "session_id": "cx-1",
      "turn_id": "t-1",
      "transcript_path": null,
      "cwd": "<REPO>",
      "hook_event_name": "PostToolUse",
      "model": "gpt-5-codex",
      "permission_mode": "default",
      "tool_name": "apply_patch",
      "tool_input": {
        "patch": "*** Begin Patch\n*** Update File: src/a.js\n@@ -1,2 +1,2 @@\n const a = 1;\n-try { x() } catch (e) { log(e) }\n+try { x() } catch (e) {}\n*** Delete File: tests/old.test.js\n*** End Patch\n"
      }
    },
    "expect": {
      "match": {
        "hookSpecificOutput.additionalContext": "src/a\\.js: adds an exception-swallowing pattern \\(\\S+\\) at line 2[\\s\\S]*tests/old\\.test\\.js \\(test file\\): deleted"
      }
    }
  },
