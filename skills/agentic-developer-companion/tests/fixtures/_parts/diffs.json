{
  "description": "diff-scope scenarios (plan §13 Diff checks + Evasion matrix). Each scenario is applied to `base` in a temp git repo, committed on a feature branch and uncommitted/untracked on main. `expect` lists the severities of non-info findings per check; checks not listed must have none. {{AWS_KEY}} is replaced at runtime by a value built from parts.",
  "registry": {
    "adc-nonexistent-pkg-zz9": false,
    "lodahs": true,
    "lodash": true,
    "left-pad": true
  },
  "base": {
    "package.json": "{\n  \"name\": \"fixture-app\",\n  \"version\": \"1.0.0\",\n  \"private\": true,\n  \"scripts\": {\n    \"test\": \"jest\"\n  },\n  \"dependencies\": {\n    \"left-pad\": \"^1.3.0\"\n  }\n}\n",
    "package-lock.json": "{\n  \"name\": \"fixture-app\",\n  \"version\": \"1.0.0\",\n  \"lockfileVersion\": 3,\n  \"requires\": true,\n  \"packages\": {\n    \"\": {\n      \"name\": \"fixture-app\",\n      \"version\": \"1.0.0\",\n      \"dependencies\": {\n        \"left-pad\": \"^1.3.0\"\n      }\n    },\n    \"node_modules/left-pad\": {\n      \"version\": \"1.3.0\",\n      \"resolved\": \"https://registry.npmjs.org/left-pad/-/left-pad-1.3.0.tgz\",\n      \"license\": \"WTFPL\"\n    }\n  }\n}\n",
    "jest.config.js": "module.exports = {\n  testEnvironment: 'node',\n  testMatch: ['**/tests/**/*.test.js'],\n};\n",
    ".eslintrc.json": "{\n  \"root\": true,\n  \"extends\": [\"eslint:recommended\"],\n  \"rules\": {\n    \"no-unused-vars\": \"error\",\n    \"no-console\": \"warn\"\n  }\n}\n",
    "src/math.js": "function add(a, b) {\n  return a + b;\n}\n\nfunction divide(a, b) {\n  if (b === 0) {\n    throw new Error('division by zero');\n  }\n  return a / b;\n}\n\nmodule.exports = { add, divide };\n",
    "src/logger.js": "function report(err) {\n  console.error('request failed', err);\n}\n\nmodule.exports = { report };\n",
    "src/util.ts": "export function parsePort(value: string): number {\n  const n = Number(value);\n  return Number.isInteger(n) ? n : 0;\n}\n",
    "tests/math.test.js": "const { add, divide } = require('../src/math');\n\ndescribe('math', () => {\n  it('adds', () => {\n    expect(add(1, 2)).toBe(3);\n  });\n\n  it('adds negatives', () => {\n    expect(add(-1, -2)).toBe(-3);\n  });\n\n  it('divides', () => {\n    expect(divide(6, 3)).toBe(2);\n    expect(() => divide(1, 0)).toThrow('division by zero');\n  });\n});\n",
    "pyproject.toml": "[project]\nname = \"fixture-service\"\nversion = \"0.1.0\"\ndependencies = [\"requests>=2.31\"]\n\n[tool.ruff]\nline-length = 100\n",
    "pytest.ini": "[pytest]\ntestpaths = tests\naddopts = -ra\n",
    "app/__init__.py": "",
    "app/service.py": "import json\n\n\ndef load(text):\n    try:\n        return json.loads(text)\n    except ValueError as exc:\n        raise RuntimeError(\"invalid payload\") from exc\n\n\ndef total(items):\n    return sum(item[\"price\"] for item in items)\n",
    "tests/test_service.py": "from app.service import load, total\n\n\ndef test_load_parses_json():\n    assert load('{\"a\": 1}') == {\"a\": 1}\n\n\ndef test_total_sums_prices():\n    assert total([{\"price\": 2}, {\"price\": 3}]) == 5\n",
    "go.mod": "module example.com/fixture\n\ngo 1.22\n",
    "calc/calc.go": "package calc\n\n// Add returns the sum of a and b.\nfunc Add(a, b int) int {\n\treturn a + b\n}\n",
    "calc/calc_test.go": "package calc\n\nimport \"testing\"\n\nfunc TestAdd(t *testing.T) {\n\tif got := Add(2, 3); got != 5 {\n\t\tt.Errorf(\"Add(2, 3) = %d, want 5\", got)\n\t}\n}\n",
    "rust/Cargo.toml": "[package]\nname = \"fixture-rs\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[dependencies]\n",
    "rust/Cargo.lock": "# This file is automatically @generated by Cargo.\n# It is not intended for manual editing.\nversion = 4\n\n[[package]]\nname = \"fixture-rs\"\nversion = \"0.1.0\"\n",
    "rust/src/lib.rs": "pub fn double(x: i32) -> i32 {\n    x * 2\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn doubles() {\n        assert_eq!(double(2), 4);\n    }\n}\n",
    ".github/workflows/ci.yml": "name: ci\non:\n  pull_request:\njobs:\n  test:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n      - run: npm ci\n      - run: npm test -- --ci\n      - run: python -m pytest\n"
  },
